<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- The world map's pin pool creates pins from this virtual template (WorldMapFrame:AcquirePin).
	     MapPinsPinMixin is filled from MapCanvasPinMixin in MapPins.lua before the first pin is made. -->
	<Frame name="MapPinsPinTemplate" hidden="true" enableMouse="true" mixin="MapPinsPinMixin" virtual="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
	</Frame>
</Ui>
